{
    "name": "danielsiepmann/tracking",
    "description": "Tracking for TYPO3",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "homepage": "https://daniel-siepmann.de/projects/typo3-extension-tracking.html",
    "support": {
        "email": "coding@daniel-siepmann.de",
        "source": "https://github.com/DanielSiepmann/tracking/",
        "issues": "https://github.com/DanielSiepmann/tracking/issues"
    },
    "authors": [
        {
            "name": "Daniel Siepmann",
            "email": "coding@daniel-siepmann.de"
        }
    ],
    "autoload": {
        "psr-4": {
            "DanielSiepmann\\Tracking\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DanielSiepmann\\Tracking\\Tests\\": "Tests/"
        }
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "ext-mbstring": "*",
        "doctrine/dbal": "^4.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "symfony/console": "^7.2",
        "symfony/expression-language": "^7.2",
        "typo3/cms-backend": "^14.3",
        "typo3/cms-core": "^14.3",
        "typo3/cms-dashboard": "^14.3"
    },
    "require-dev": {
        "codappix/typo3-php-datasets": "^2.1",
        "cweagans/composer-patches": "^2.0",
        "friendsofphp/php-cs-fixer": "3.93.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "saschaegerer/phpstan-typo3": "^2.1 || ^3.0",
        "typo3/testing-framework": "^9.3"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "mkdir -p .Build/web/typo3conf/ext/",
            "[ -L .Build/web/typo3conf/ext/tracking ] || ln -snvf ../../../../. .Build/web/typo3conf/ext/tracking"
        ]
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "tracking",
            "web-dir": ".Build/web"
        },
        "composer-patches": {
            "patches-file": "patches/patches.json"
        }
    },
    "config": {
        "sort-packages": true,
        "lock": false,
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "phpstan/extension-installer": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    }
}
